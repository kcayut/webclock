# Legacy fallback only; new users configure the calendar URL in /admin.
# Supports Google iCal, Apple iCloud public calendar, or another ICS feed.
# Once saved in /admin, webclock_state/calendar.json takes precedence.
ICAL_URL=

# Server Configuration
PORT=5000
HOST=0.0.0.0

# Optional: require this Bearer token for /api/v1/device/*
DEVICE_API_TOKEN=

# Optional: defaults to project-local webclock_state (back up and mount overrides yourself)
# WEBCLOCK_STATE_DIR=/path/to/webclock_state
