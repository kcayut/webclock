# Legacy fallback only; new users configure the calendar URL in /admin.
# Supports Google iCal, Apple iCloud public calendar, or another ICS feed.
# Once saved in /admin, webclock_state/calendar.json takes precedence.
ICAL_URL=

# Server Configuration
PORT=5000
HOST=0.0.0.0

# Initial interface language: zh-TW, en, or ja.
# A later sidebar selection is saved in webclock_state/settings.json.
WEBCLOCK_LANGUAGE=zh-TW

# Self mode only: optionally require this shared Bearer token for /api/v1/device/*.
# Managed mode does not accept this token for private data or administrator login.
DEVICE_API_TOKEN=

# Existing installations remain in self mode. Authorization mode is persisted in
# auth.json, not selected by an environment variable. To enable managed mode,
# stop writers, make a host backup, then run scripts/manage_auth.py setup with
# --enable-managed as the service user (see the guide for --state-dir and HTTPS).
# Never put administrator passwords, session secrets or invite codes in .env.
#
# Optional: defaults to project-local webclock_state. Back up and mount the entire
# chosen directory: it includes auth.json, auth-required and device-access.json.
# Keep the directory private (700) and authorization files private (600).
# Historical host restore invalidates sessions, invite codes and device credentials;
# a protected installation cannot restore an old backup without authorization data.
# WEBCLOCK_STATE_DIR=/path/to/webclock_state
